# ─────────────────────────────────────────────────────────────
# Incredible Souls — Environment configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it is git-ignored).
# No database is used — enrollment/contact data is delivered by email only.
# ─────────────────────────────────────────────────────────────

# ── Razorpay ──────────────────────────────────────────────────
# Server-only secret (create orders + verify signatures). NEVER exposed to the browser.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Public key id — safe to expose; used by the checkout script on the client.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# ── SMTP / Email (Nodemailer) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_EMAIL=your-smtp-user@gmail.com

# ── Lead recipients ───────────────────────────────────────────
TO_EMAIL=leads@example.com          # contact-form leads
TO_EMAIL_COURCE=leads@example.com   # course enrollment leads
